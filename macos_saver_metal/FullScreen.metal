// Vertex stage for fragment shaders generated by impellerc from Flutter
// runtime-effect GLSL (shaders/hyperspace_saver.frag): one triangle covering
// the view, passing the fragment position in logical pixels, origin top
// left - what FlutterFragCoord() returns in Flutter (Impeller feeds it the
// same way, from its runtime_effect.vert, at user(locn0)).

#include <metal_stdlib>
using namespace metal;

struct FullScreenOut {
  float4 position [[position]];
  float2 fragCoord [[user(locn0)]];
};

vertex FullScreenOut fullScreenVertex(uint id [[vertex_id]], constant float2& size [[buffer(0)]]) {
  // Clip space (-1,-1), (3,-1), (-1,3): covers the whole view.
  float2 uv = float2((id << 1) & 2, id & 2);
  float2 clip = uv * 2.0 - 1.0;
  FullScreenOut out;
  out.position = float4(clip, 0.0, 1.0);
  // Clip y points up, Flutter's y down: x = (clip.x + 1) / 2, y = (1 - clip.y) / 2.
  out.fragCoord = float2(uv.x, 1.0 - uv.y) * size;
  return out;
}
